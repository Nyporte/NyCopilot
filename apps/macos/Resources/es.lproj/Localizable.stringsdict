<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>%ld more in Settings → %@</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld más en Ajustes → %2$@</string><key>other</key><string>%1$ld más en Ajustes → %2$@</string></dict></dict>
<key>%ld frames a second</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld fotograma por segundo</string><key>other</key><string>%1$ld fotogramas por segundo</string></dict></dict>
<key>Copied %ld lines of text</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld línea de texto copiada</string><key>other</key><string>%1$ld líneas de texto copiadas</string></dict></dict>
<key>Select the %ld lines of text in place (T)</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>Seleccionar %1$ld línea de texto en su sitio (T)</string><key>other</key><string>Seleccionar las %1$ld líneas de texto en su sitio (T)</string></dict></dict>
<key>%ld entries</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld entrada</string><key>other</key><string>%1$ld entradas</string></dict></dict>
<key>Inbox (%ld)</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>Bandeja de entrada (%1$ld)</string><key>other</key><string>Bandeja de entrada (%1$ld)</string></dict></dict>
<key>%ld notes are back in your inbox</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld nota ha vuelto a tu bandeja de entrada</string><key>other</key><string>%1$ld notas han vuelto a tu bandeja de entrada</string></dict></dict>
<key>You can keep up to %ld languages.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>Puedes guardar hasta %1$ld idioma.</string><key>other</key><string>Puedes guardar hasta %1$ld idiomas.</string></dict></dict>
<key>Imported %ld shortcuts from Rectangle.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld función rápida importada de Rectangle.</string><key>other</key><string>%1$ld funciones rápidas importadas de Rectangle.</string></dict></dict>
<key> Skipped %ld Rectangle-only actions (%@).</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string> Se ha omitido %1$ld acción exclusiva de Rectangle (%2$@).</string><key>other</key><string> Se han omitido %1$ld acciones exclusivas de Rectangle (%2$@).</string></dict></dict>
<key> %ld couldn’t be registered; quit Rectangle and import again.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string> %1$ld no se ha podido registrar; sal de Rectangle e importa de nuevo.</string><key>other</key><string> %1$ld no se han podido registrar; sal de Rectangle e importa de nuevo.</string></dict></dict>
</dict></plist>
