<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>%ld more in Settings → %@</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld de plus dans Réglages → %2$@</string><key>other</key><string>%1$ld de plus dans Réglages → %2$@</string></dict></dict>
<key>%ld frames a second</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld image par seconde</string><key>other</key><string>%1$ld images par seconde</string></dict></dict>
<key>Copied %ld lines of text</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld ligne de texte copiée</string><key>other</key><string>%1$ld lignes de texte copiées</string></dict></dict>
<key>Select the %ld lines of text in place (T)</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>Sélectionner %1$ld ligne de texte sur place (T)</string><key>other</key><string>Sélectionner les %1$ld lignes de texte sur place (T)</string></dict></dict>
<key>%ld entries</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld entrée</string><key>other</key><string>%1$ld entrées</string></dict></dict>
<key>Inbox (%ld)</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>Boîte de réception (%1$ld)</string><key>other</key><string>Boîte de réception (%1$ld)</string></dict></dict>
<key>%ld notes are back in your inbox</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld note est de retour dans votre boîte de réception</string><key>other</key><string>%1$ld notes sont de retour dans votre boîte de réception</string></dict></dict>
<key>You can keep up to %ld languages.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>Vous pouvez garder jusqu’à %1$ld langue.</string><key>other</key><string>Vous pouvez garder jusqu’à %1$ld langues.</string></dict></dict>
<key>Imported %ld shortcuts from Rectangle.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld raccourci importé de Rectangle.</string><key>other</key><string>%1$ld raccourcis importés de Rectangle.</string></dict></dict>
<key> Skipped %ld Rectangle-only actions (%@).</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string> %1$ld action propre à Rectangle ignorée (%2$@).</string><key>other</key><string> %1$ld actions propres à Rectangle ignorées (%2$@).</string></dict></dict>
<key> %ld couldn’t be registered; quit Rectangle and import again.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string> %1$ld n’a pas pu être enregistré ; quittez Rectangle et importez à nouveau.</string><key>other</key><string> %1$ld n’ont pas pu être enregistrés ; quittez Rectangle et importez à nouveau.</string></dict></dict>
</dict></plist>
