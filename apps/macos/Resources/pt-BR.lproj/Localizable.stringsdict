<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>%ld more in Settings → %@</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>Mais %1$ld em Ajustes → %2$@</string><key>other</key><string>Mais %1$ld em Ajustes → %2$@</string></dict></dict>
<key>%ld frames a second</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld quadro por segundo</string><key>other</key><string>%1$ld quadros por segundo</string></dict></dict>
<key>Copied %ld lines of text</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld linha de texto copiada</string><key>other</key><string>%1$ld linhas de texto copiadas</string></dict></dict>
<key>Select the %ld lines of text in place (T)</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>Selecionar %1$ld linha de texto no lugar (T)</string><key>other</key><string>Selecionar as %1$ld linhas de texto no lugar (T)</string></dict></dict>
<key>%ld entries</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld item</string><key>other</key><string>%1$ld itens</string></dict></dict>
<key>Inbox (%ld)</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>Caixa de Entrada (%1$ld)</string><key>other</key><string>Caixa de Entrada (%1$ld)</string></dict></dict>
<key>%ld notes are back in your inbox</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld nota voltou à Caixa de Entrada</string><key>other</key><string>%1$ld notas voltaram à Caixa de Entrada</string></dict></dict>
<key>You can keep up to %ld languages.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>Você pode manter até %1$ld idioma.</string><key>other</key><string>Você pode manter até %1$ld idiomas.</string></dict></dict>
<key>Imported %ld shortcuts from Rectangle.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld atalho importado do Rectangle.</string><key>other</key><string>%1$ld atalhos importados do Rectangle.</string></dict></dict>
<key> Skipped %ld Rectangle-only actions (%@).</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string> %1$ld ação exclusiva do Rectangle ignorada (%2$@).</string><key>other</key><string> %1$ld ações exclusivas do Rectangle ignoradas (%2$@).</string></dict></dict>
<key> %ld couldn’t be registered; quit Rectangle and import again.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string> %1$ld não pôde ser registrado; encerre o Rectangle e importe de novo.</string><key>other</key><string> %1$ld não puderam ser registrados; encerre o Rectangle e importe de novo.</string></dict></dict>
</dict></plist>
