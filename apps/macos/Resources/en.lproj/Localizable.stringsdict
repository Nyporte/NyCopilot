<plist version="1.0"><dict>
<key>%ld more in Settings → %@</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld more in Settings → %2$@</string><key>other</key><string>%1$ld more in Settings → %2$@</string></dict></dict>
<key>%ld frames a second</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld frame a second</string><key>other</key><string>%1$ld frames a second</string></dict></dict>
<key>Copied %ld lines of text</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>Copied %1$ld line of text</string><key>other</key><string>Copied %1$ld lines of text</string></dict></dict>
<key>Select the %ld lines of text in place (T)</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>Select the %1$ld line of text in place (T)</string><key>other</key><string>Select the %1$ld lines of text in place (T)</string></dict></dict>
<key>%ld entries</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld entry</string><key>other</key><string>%1$ld entries</string></dict></dict>
<key>Inbox (%ld)</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>Inbox (%1$ld)</string><key>other</key><string>Inbox (%1$ld)</string></dict></dict>
<key>%ld notes are back in your inbox</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld note is back in your inbox</string><key>other</key><string>%1$ld notes are back in your inbox</string></dict></dict>
<key>You can keep up to %ld languages.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>You can keep up to %1$ld language.</string><key>other</key><string>You can keep up to %1$ld languages.</string></dict></dict>
<key>Imported %ld shortcuts from Rectangle.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>Imported %1$ld shortcut from Rectangle.</string><key>other</key><string>Imported %1$ld shortcuts from Rectangle.</string></dict></dict>
<key> Skipped %ld Rectangle-only actions (%@).</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string> Skipped %1$ld Rectangle-only action (%2$@).</string><key>other</key><string> Skipped %1$ld Rectangle-only actions (%2$@).</string></dict></dict>
<key> %ld couldn’t be registered; quit Rectangle and import again.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string> %1$ld couldn’t be registered; quit Rectangle and import again.</string><key>other</key><string> %1$ld couldn’t be registered; quit Rectangle and import again.</string></dict></dict>
