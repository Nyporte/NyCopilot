<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>%ld more in Settings → %@</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld weiterer unter Einstellungen → %2$@</string><key>other</key><string>%1$ld weitere unter Einstellungen → %2$@</string></dict></dict>
<key>%ld frames a second</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld Bild pro Sekunde</string><key>other</key><string>%1$ld Bilder pro Sekunde</string></dict></dict>
<key>Copied %ld lines of text</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld Zeile Text kopiert</string><key>other</key><string>%1$ld Zeilen Text kopiert</string></dict></dict>
<key>Select the %ld lines of text in place (T)</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld Zeile Text direkt auswählen (T)</string><key>other</key><string>Die %1$ld Zeilen Text direkt auswählen (T)</string></dict></dict>
<key>%ld entries</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld Eintrag</string><key>other</key><string>%1$ld Einträge</string></dict></dict>
<key>Inbox (%ld)</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>Eingang (%1$ld)</string><key>other</key><string>Eingang (%1$ld)</string></dict></dict>
<key>%ld notes are back in your inbox</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld Notiz ist zurück im Eingang</string><key>other</key><string>%1$ld Notizen sind zurück im Eingang</string></dict></dict>
<key>You can keep up to %ld languages.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>Du kannst bis zu %1$ld Sprache behalten.</string><key>other</key><string>Du kannst bis zu %1$ld Sprachen behalten.</string></dict></dict>
<key>Imported %ld shortcuts from Rectangle.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string>%1$ld Kurzbefehl aus Rectangle importiert.</string><key>other</key><string>%1$ld Kurzbefehle aus Rectangle importiert.</string></dict></dict>
<key> Skipped %ld Rectangle-only actions (%@).</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string> %1$ld Rectangle-eigene Aktion übersprungen (%2$@).</string><key>other</key><string> %1$ld Rectangle-eigene Aktionen übersprungen (%2$@).</string></dict></dict>
<key> %ld couldn’t be registered; quit Rectangle and import again.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>ld</string><key>one</key><string> %1$ld konnte nicht registriert werden; beende Rectangle und importiere erneut.</string><key>other</key><string> %1$ld konnten nicht registriert werden; beende Rectangle und importiere erneut.</string></dict></dict>
</dict></plist>
