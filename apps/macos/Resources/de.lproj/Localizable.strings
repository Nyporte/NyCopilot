"Hide Menu Bar Icons" = "Menüleistensymbole ausblenden";
"Menu Bar Settings…" = "Menüleisten-Einstellungen …";
"Menu bar icons" = "Menüleistensymbole";
"Hide again" = "Wieder ausblenden";
"After showing hidden icons. Not while the pointer is on the menu bar." = "Nachdem ausgeblendete Symbole gezeigt wurden. Nicht, solange der Zeiger auf der Menüleiste ist.";
"Shortcut" = "Kurzbefehl";
"Never" = "Nie";
"After 1 minute" = "Nach 1 Minute";
"After %ld seconds" = "Nach %ld Sekunden";
"Tidy the menu bar" = "Menüleiste aufräumen";
"Hide the menu bar icons you rarely need; one click shows them." = "Selten gebrauchte Menüleistensymbole ausblenden; ein Klick zeigt sie.";
"Icons must hide again after 0 to 600 seconds." = "Symbole müssen nach 0 bis 600 Sekunden wieder ausgeblendet werden.";
"⌘-drag menu bar icons left of this arrow to hide them" = "Menüleistensymbole mit ⌘ links neben diesen Pfeil ziehen, um sie auszublenden";
"⌘-drag icons left of the arrow to hide them, and right of it to keep them in sight. Click the arrow to show or hide them; right-click it for Settings. On a Mac with a notch, icons that don’t fit beside it stay out of sight even when shown." = "Ziehe Symbole mit ⌘ links neben den Pfeil, um sie auszublenden, und rechts daneben, um sie sichtbar zu lassen. Klicke auf den Pfeil, um sie zu zeigen oder auszublenden; ein Rechtsklick öffnet die Einstellungen. Auf einem Mac mit Notch bleiben Symbole, die daneben keinen Platz haben, auch eingeblendet unsichtbar.";
"Hide icons behind an arrow" = "Symbole hinter einem Pfeil ausblenden";
"Puts an arrow in the menu bar." = "Setzt einen Pfeil in die Menüleiste.";
"Couldn’t hide the icons" = "Symbole konnten nicht ausgeblendet werden";
"⌘-drag the arrow a little, then try again." = "Ziehe den Pfeil mit ⌘ ein wenig und versuche es erneut.";
"Show hidden icons in a bar" = "Ausgeblendete Symbole in einer Leiste zeigen";
"Clicking the arrow opens them in a row under the menu bar instead; clicking one opens its menu. Their pictures need Screen Recording." = "Ein Klick auf den Pfeil zeigt sie stattdessen in einer Reihe unter der Menüleiste; ein Klick auf eines öffnet sein Menü. Ihre Bilder brauchen die Bildschirmaufnahme.";
"Show Icons in the Menu Bar" = "Symbole in der Menüleiste zeigen";
"No icons are hidden" = "Keine Symbole ausgeblendet";
"Couldn’t reach that icon" = "Dieses Symbol ließ sich nicht öffnen";
"It didn’t fit in the menu bar." = "Es passte nicht in die Menüleiste.";
"Hidden menu bar icons" = "Ausgeblendete Menüleistensymbole";
